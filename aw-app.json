{
  "manifest_version": 1,
  "id": "plaud",
  "name": "Plaud",
  "version": "0.2.1",
  "description": "Browse your Plaud AI recorder notes without leaving the workspace: see every recording, play or download the original audio, and read the transcript and AI summary \u2014 plus the 5 aw-plaud MCP tools an agent can use to pull the same data.",
  "icon": "mic",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "low"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "plaud_app.plugin:PlaudAppPlugin",
    "pip_requires": [
      "httpx>=0.24"
    ]
  },
  "permissions": [
    "routes:register",
    "secrets:own",
    "ui:code"
  ],
  "contributes": {
    "routes": [
      {
        "prefix": "/api/apps/plaud"
      }
    ],
    "windows": [
      {
        "id": "plaud.main",
        "title": "Plaud",
        "icon": "mic",
        "body": {
          "type": "component"
        }
      },
      {
        "id": "plaud.settings",
        "title": "Plaud",
        "icon": "mic",
        "body": {
          "type": "declarative",
          "spec": "windows/settings.json"
        }
      }
    ],
    "frontend": {
      "mode": "component",
      "bundle": "ui/dist/plaud-ui.mjs",
      "slots": [
        "core.window.body:plaud.main"
      ]
    },
    "settings_panels": [
      {
        "id": "plaud.settings",
        "window": "plaud.settings"
      }
    ],
    "mcp": {
      "reload_on_save": true,
      "provides": [
        "plaud_status",
        "plaud_list_recordings",
        "plaud_get_transcript",
        "plaud_get_summary",
        "plaud_download_audio"
      ]
    },
    "skills": [
      {
        "id": "aw-plaud",
        "path": "skills/aw-plaud/SKILL.md",
        "description": "Personal Plaud account connector \u2014 tool reference, the Apps \u203a Plaud UI, how to obtain/refresh the bearer token, and known limitations."
      }
    ]
  },
  "dependencies": {
    "apps": [
      {
        "id": "mcp-gateway",
        "version": ">=0.1.0",
        "required": true,
        "reason": "This app contributes its own mcp.json (the aw-plaud server) that MCP Gateway discovers and merges."
      }
    ]
  },
  "migrations": {}
}
